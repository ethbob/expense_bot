# Обязательные
BOT_TOKEN=123456:ABC-токен-от-BotFather
OWNER_ID=123456789
WALLET_ADDRESS=0xВашАдресКошелька
DATABASE_URL=postgresql://user:pass@host:5432/db

# Необязательные (значения по умолчанию)
# TZ_NAME=Europe/Moscow
# POLL_INTERVAL=30          # как часто проверять блокчейн, сек
# CONFIRMATIONS=5           # сколько блоков ждать после перевода
# MIN_AMOUNT=0.01           # переводы меньше этой суммы игнорируются (спам)
# MAX_BLOCK_RANGE=500       # размер шага сканирования
# BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.bnbchain.org
